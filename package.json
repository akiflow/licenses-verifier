{
  "name": "@akiflow/licenses-verifier",
  "version": "3.1.0",
  "description": "Verify that the dependencies of package.json are licensed in a way that allows their use in the current project. Zero dependencies.",
  "repository": "https://github.com/akiflow/licenses-verifier.git",
  "author": "Don <4340360+ilDon@users.noreply.github.com>",
  "license": "MIT",
  "engines": {
    "node": ">=14.0.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "licenses-verifier": "./bin/licenses-verifier.js"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "bin/licenses-verifier.js",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "node scripts/clean.js",
    "build": "node scripts/clean.js && tsc -p tsconfig.build.json",
    "watch": "tsc -p tsconfig.build.json --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node scripts/clean.js && tsc -p tsconfig.build.json && bun test",
    "test:only": "bun test",
    "test:watch": "bun test --watch",
    "test:coverage": "bun test --coverage",
    "verify-package": "node scripts/verify-package.js",
    "smoke-test": "node scripts/smoke-test.js",
    "self-check": "node scripts/clean.js && tsc -p tsconfig.build.json && node bin/licenses-verifier.js",
    "publishToNpm": "npm publish --access public --registry https://registry.npmjs.org",
    "prepublishOnly": "node scripts/clean.js && tsc -p tsconfig.build.json && tsc --noEmit -p tsconfig.json && bun test --coverage && node scripts/verify-package.js && node scripts/smoke-test.js"
  },
  "whitelistedLicenses": [
    "MIT",
    "Apache-2.0",
    "BSD-3-Clause",
    "BSD-2-Clause",
    "ISC",
    "Python-2.0",
    "CC-BY-3.0",
    "CC0-1.0",
    "(MIT AND CC-BY-3.0)",
    "0BSD",
    "(MIT OR CC0-1.0)",
    "BlueOak-1.0.0"
  ],
  "devDependencies": {
    "@types/bun": "^1.4.0",
    "@types/node": "^20.11.5",
    "typescript": "^5.3.3"
  },
  "keywords": [
    "licenses",
    "compliance",
    "verifier",
    "legal",
    "copyright",
    "IP",
    "intellectual property",
    "zero-dependencies",
    "sbom"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  }
}
